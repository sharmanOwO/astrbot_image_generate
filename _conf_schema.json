{
  "api_key": {
    "description": "中转站 API Key",
    "type": "string",
    "hint": "只填写密钥本身，不要包含 Bearer 前缀。",
    "obvious_hint": true,
    "default": ""
  },
  "api_url": {
    "description": "中转站生图接口地址",
    "type": "string",
    "default": "https://api.apiqik.com/v1/images/generations"
  },
  "edit_api_url": {
    "description": "中转站图生图接口地址",
    "type": "string",
    "default": "https://api.apiqik.com/v1/images/edits"
  },
  "model": {
    "description": "生图模型名称",
    "type": "string",
    "hint": "文生图和图生图共用此模型，请填写接口支持的模型名称。留空使用默认模型。",
    "default": "gpt-image-2-5-sunburst"
  },
  "request_timeout": {
    "description": "生图请求超时时间（秒）",
    "type": "int",
    "hint": "有效范围为 30 至 600 秒。",
    "default": 480
  }
}
